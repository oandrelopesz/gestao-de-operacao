    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "version": 2 }, "combinator": "and",
          "conditions": [ { "leftValue": "={{ $json.id }}", "rightValue": "", "operator": { "type": "string", "operation": "exists", "singleValue": true } } ] },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Tem job?",

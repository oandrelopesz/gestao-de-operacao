      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Item baixando",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, -100],
      "credentials": { "httpHeaderAuth": { "id": "gsuRHTRCgsQs1iRF", "name": "Supabase - Gestão de Operação NOVO (anon)" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://swipe_worker:8080/job",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "x-worker-key", "value": "SUBSTITUIR_PELA_WORKER_KEY" }, { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Tem job?').item.json.id, tipo: $('Tem job?').item.json.tipo, payload: $('Tem job?').item.json.payload, ultima_tentativa: $('Tem job?').item.json.tentativas + 1 >= 3 }) }}",
        "options": { "timeout": 1800000, "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Executar no worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [740, -100]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst job = $('Tem job?').first().json;\nconst corpo = r.body || {};\nconst status = r.statusCode || 0;\nconst tentativas = job.tentativas + 1;\n\n// Sem resposta HTTP (worker reiniciando, rede, timeout do n8n): o nó entrega { error } em vez de\n// { statusCode, body }. É infraestrutura, como o 503: volta para a fila sem consumir tentativa.\nif (r.error) {\n  const msg = r.error.message || (typeof r.error === 'string' ? r.error : JSON.stringify(r.error));\n  return [{ json: { acao: 'devolver', job_id: job.id, item_id: job.item_id, tentativas: job.tentativas, erro: `sem resposta do worker: ${msg}` } }];\n}\n\n// 409 (ocupado) e 503 (Drive fora) não consomem tentativa: o job volta para a fila\nif (status === 409 || status === 503) {\n  return [{ json: { acao: 'devolver', job_id: job.id, item_id: job.item_id, tentativas: job.tentativas, erro: corpo.erro || `worker respondeu ${status}` } }];\n}\n\n// Pausado pelo usuário no app (job e item já estão como 'pausado'): não mexe em nada\nif (corpo.pausado) {\n  return [{ json: { acao: 'pausado', job_id: job.id, item_id: job.item_id } }];\n}\n\nif (corpo.ok === true) {\n  return [{ json: { acao: 'ok', job_id: job.id, item_id: job.item_id, resultado: corpo.resultado } }];\n}\n\nconst erro = corpo.erro || `worker respondeu ${status}`;\nif (tentativas < 3) {\n  return [{ json: { acao: 'devolver', job_id: job.id, item_id: job.item_id, tentativas, erro } }];\n}\nreturn [{ json: { acao: 'falhou', job_id: job.id, item_id: job.item_id, tentativas, erro, docs: corpo.docs || null, link: job.payload.link, nome: job.payload.nome_arquivo } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Decidir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, -100]
    },
    {
      "parameters": {
        "rules": { "values": [
          { "conditions": { "options": { "caseSensitive": true, "version": 2 }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.acao }}", "rightValue": "ok", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "ok" },
          { "conditions": { "options": { "caseSensitive": true, "version": 2 }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.acao }}", "rightValue": "devolver", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "devolver" },
          { "conditions": { "options": { "caseSensitive": true, "version": 2 }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.acao }}", "rightValue": "falhou", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "falhou" }
        ] },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Rotear",

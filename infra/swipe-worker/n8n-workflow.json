        "url": "=https://uajusldnvzgakffofkhl.supabase.co/rest/v1/swipe_itens?id=eq.{{ $('Tem job?').item.json.item_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",

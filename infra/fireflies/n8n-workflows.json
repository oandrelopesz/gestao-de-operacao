[
  {
    "name": "[FIREFLIES] Webhook da transcrição",
    "settings": {
      "executionOrder": "v1",
      "timezone": "America/Sao_Paulo"
    },
    "nodes": [
      {
        "id": "b7f0f7a2-51f4-4d38-9b54-6f1f0f1a0001",
        "name": "Transcrição pronta",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          0
        ],
        "webhookId": "5d0c7f3e-3c55-4a8e-9a57-1f7c2b9e0f11",
        "parameters": {
          "httpMethod": "POST",
          "path": "fireflies-transcricao",
          "responseMode": "onReceived",
          "options": {
            "rawBody": true
          }
        }
      },
      {
        "id": "b7f0f7a2-51f4-4d38-9b54-6f1f0f1a0002",
        "name": "Corpo cru e assinatura",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          240,
          0
        ],
        "parameters": {
          "jsCode": "// O worker confere a assinatura (HMAC SHA-256) sobre o corpo exatamente como o Fireflies enviou.\nconst item = $input.first();\nlet corpo = '';\nif (item.binary && item.binary.data) {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  corpo = buf.toString('utf8');\n} else {\n  corpo = JSON.stringify(item.json.body ?? {});\n}\nconst headers = item.json.headers || {};\nreturn [{ json: { corpo, assinatura: headers['x-hub-signature'] || '' } }];"
        }
      },
      {
        "id": "b7f0f7a2-51f4-4d38-9b54-6f1f0f1a0003",
        "name": "Importar no worker",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          480,
          0
        ],
        "parameters": {
          "method": "POST",
          "url": "http://swipe_worker:8080/fireflies/webhook",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "x-worker-key",
                "value": "SUBSTITUIR_PELA_WORKER_KEY"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ corpo: $json.corpo, assinatura: $json.assinatura }) }}",
          "options": {
            "timeout": 300000,
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        }
      }
    ],
    "connections": {
      "Transcrição pronta": {
        "main": [
          [
            {
              "node": "Corpo cru e assinatura",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Corpo cru e assinatura": {
        "main": [
          [
            {
              "node": "Importar no worker",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  },
